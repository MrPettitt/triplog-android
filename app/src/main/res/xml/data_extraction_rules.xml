<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup rules. Only the trip database and receipt photos are backed up, because
  until the server can send records back this is the only way to recover data on a new phone.
  Everything else (WorkManager's queue, caches) is left out. Keep in sync with backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="triplog.db" />
        <include domain="database" path="triplog.db-wal" />
        <include domain="database" path="triplog.db-shm" />
        <include domain="external" path="Pictures/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="triplog.db" />
        <include domain="database" path="triplog.db-wal" />
        <include domain="database" path="triplog.db-shm" />
        <include domain="external" path="Pictures/" />
    </device-transfer>
</data-extraction-rules>
